# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Data: large source files live on BDSP, not in git.
data/*.csv
data/*.xlsx
data/*.mat
data/*.7z
data/*.parquet
!data/README.md

# Outputs.
figures/*.png
figures/*.pdf
figures/*.csv
!figures/README.md

# Notebook executions.
notebooks_original/**/_outputs/

# Staging area (bundled .h5, de-identified CSVs etc. headed for BDSP/S3).
staging/

# Scratch / one-off working directories.
_scratch/
_s3_listings/

# Reproduction data lives on S3 (see data/raw/manifest.csv) — never commit it
/data/*.csv
/data/*.xlsx
/data/_unzipped/
# Generated figure outputs (regenerate via scripts/reproduce_all.py)
/figures/*.png
/figures/*.pdf
/figures/*.csv
!/data/raw/manifest.csv
